  <body dur="02:43.450">
    <div begin="00:00.850" end="02:43.450">
      <p begin="00:00.850" end="00:04.010" ttm:agent="v1" itunes:key="L1"><span begin="00:00.850" end="00:01.160">Run</span> <span begin="00:01.160" end="00:01.550">of</span> <span begin="00:01.550" end="00:01.660">the</span> <span begin="00:01.730" end="00:02.030">mi</span><span begin="00:02.030" end="00:02.330">ll</span> <span begin="00:03.390" end="00:03.660">ah</span> <span begin="00:03.720" end="00:04.010">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d'extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p>
      <p begin="00:05.390" end="00:06.950" ttm:agent="v1" itunes:key="L2"><span begin="00:05.390" end="00:05.700">But</span> <span begin="00:05.700" end="00:05.970">I</span> <span begin="00:05.970" end="00:06.230">love</span> <span begin="00:06.230" end="00:06.550">those</span> <span begin="00:06.550" end="00:06.850">thing</span><span begin="00:06.850" end="00:06.950">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j'aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p>
      <p begin="00:07.900" end="00:09.600" ttm:agent="v1" itunes:key="L3"><span begin="00:07.900" end="00:08.410">For</span><span begin="00:08.780" end="00:09.290">e</span><span begin="00:09.370" end="00:09.600">ver</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到永远</span><span ttm:role="x-translation" xml:lang="zh-Hant">直到永遠</span><span ttm:role="x-translation" xml:lang="ja">いつまでも</span><span ttm:role="x-translation" xml:lang="ko">영원히</span><span ttm:role="x-translation" xml:lang="fr">Pour toujours</span><span ttm:role="x-translation" xml:lang="es">Para siempre</span><span ttm:role="x-translation" xml:lang="de">Für immer</span><span ttm:role="x-translation" xml:lang="pt">Para sempre</span><span ttm:role="x-translation" xml:lang="ru">Навсегда</span><span ttm:role="x-translation" xml:lang="ar">إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Per sempre</span></p>
      <p begin="00:09.910" end="00:13.020" ttm:agent="v1" itunes:key="L4"><span begin="00:09.910" end="00:10.210">Run</span> <span begin="00:10.210" end="00:10.590">of</span> <span begin="00:10.590" end="00:10.720">the</span> <span begin="00:10.790" end="00:11.060">mi</span><span begin="00:11.060" end="00:11.320">ll</span> <span begin="00:12.430" end="00:12.730">ah</span> <span begin="00:12.780" end="00:13.020">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d'extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p>
      <p begin="00:14.430" end="00:15.980" ttm:agent="v1" itunes:key="L5"><span begin="00:14.430" end="00:14.750">But</span> <span begin="00:14.750" end="00:15.030">I</span> <span begin="00:15.030" end="00:15.310">love</span> <span begin="00:15.310" end="00:15.580">those</span> <span begin="00:15.580" end="00:15.900">thing</span><span begin="00:15.900" end="00:15.980">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j'aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p>
      <p begin="00:18.650" end="00:22.520" ttm:agent="v1" itunes:key="L6"><span begin="00:18.650" end="00:19.210">夢</span><span begin="00:19.270" end="00:19.500">も</span><span begin="00:19.800" end="00:20.350">叶</span><span begin="00:20.390" end="00:20.610">う</span><span begin="00:20.930" end="00:21.220">こ</span><span begin="00:21.260" end="00:21.480">の</span><span begin="00:21.540" end="00:21.700">場</span><span begin="00:21.790" end="00:22.080">所</span><span begin="00:22.120" end="00:22.520">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这梦想也能成真的地方</span><span ttm:role="x-translation" xml:lang="zh-Hant">在這夢想也能成真的地方</span><span ttm:role="x-translation" xml:lang="en">Here in this place where even dreams come true</span><span ttm:role="x-translation" xml:lang="ko">꿈도 이루어지는 이곳에서</span><span ttm:role="x-translation" xml:lang="fr">Ici où même les rêves se réalisent</span><span ttm:role="x-translation" xml:lang="es">Aquí donde hasta los sueños se cumplen</span><span ttm:role="x-translation" xml:lang="de">Hier wo selbst Träume wahr werden</span><span ttm:role="x-translation" xml:lang="pt">Neste lugar onde os sonhos também se realizam</span><span ttm:role="x-translation" xml:lang="ru">Здесь где даже мечты сбываются</span><span ttm:role="x-translation" xml:lang="ar">هنا حيث تتحقق حتى الأحلام</span><span ttm:role="x-translation" xml:lang="it">Qui dove anche i sogni si avverano</span><span ttm:role="x-roman">Yume mo kanau kono basho de</span></p>
      <p begin="00:23.200" end="00:27.000" ttm:agent="v1" itunes:key="L7"><span begin="00:23.200" end="00:23.460">で</span><span begin="00:23.530" end="00:23.720">も</span><span begin="00:23.780" end="00:23.990">ね</span> <span begin="00:24.330" end="00:24.540">だ</span><span begin="00:24.620" end="00:24.880">け</span><span begin="00:24.920" end="00:25.140">ど</span> <span begin="00:25.480" end="00:25.670">わ</span><span begin="00:25.740" end="00:26.060">か</span><span begin="00:26.060" end="00:26.230">ら</span><span begin="00:26.330" end="00:26.630">な</span><span begin="00:26.630" end="00:27.000">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">可是啊 可是 我还是不懂</span><span ttm:role="x-translation" xml:lang="zh-Hant">可是啊 可是 我還是不懂</span><span ttm:role="x-translation" xml:lang="en">But even so I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">그런데 말이야 그래도 모르겠어</span><span ttm:role="x-translation" xml:lang="fr">Mais tu sais je ne comprends pas</span><span ttm:role="x-translation" xml:lang="es">Pero aun así no lo entiendo</span><span ttm:role="x-translation" xml:lang="de">Aber weißt du ich verstehe es nicht</span><span ttm:role="x-translation" xml:lang="pt">Mas sabe ainda assim não entendo</span><span ttm:role="x-translation" xml:lang="ru">Но знаешь всё же я не понимаю</span><span ttm:role="x-translation" xml:lang="ar">لكنني مع ذلك لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Eppure sai non capisco</span><span ttm:role="x-roman">Demo ne dakedo wakaranai</span></p>
      <p begin="00:27.690" end="00:31.340" ttm:agent="v1" itunes:key="L8"><span begin="00:27.690" end="00:27.970">画</span><span begin="00:28.040" end="00:28.570">面</span><span begin="00:28.870" end="00:29.080">の</span><span begin="00:29.150" end="00:29.670">中</span><span begin="00:29.970" end="00:30.460">探</span><span begin="00:30.530" end="00:30.720">し</span><span begin="00:30.830" end="00:31.010">て</span><span begin="00:31.130" end="00:31.340">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">就算在屏幕中寻找</span><span ttm:role="x-translation" xml:lang="zh-Hant">就算在屏幕中尋找</span><span ttm:role="x-translation" xml:lang="en">Even when I search for answers on the screen</span><span ttm:role="x-translation" xml:lang="ko">화면 속을 찾아봐도</span><span ttm:role="x-translation" xml:lang="fr">J'ai beau chercher sur l'écran</span><span ttm:role="x-translation" xml:lang="es">Por más que busque en la pantalla</span><span ttm:role="x-translation" xml:lang="de">Auch wenn ich auf dem Bildschirm danach suche</span><span ttm:role="x-translation" xml:lang="pt">Mesmo procurando na tela</span><span ttm:role="x-translation" xml:lang="ru">Сколько ни ищу на экране</span><span ttm:role="x-translation" xml:lang="ar">مهما بحثت عبر الشاشة</span><span ttm:role="x-translation" xml:lang="it">Anche se cerco sullo schermo</span><span ttm:role="x-roman">Gamen no naka sagashite mo</span></p>
      <p begin="00:31.680" end="00:35.790" ttm:agent="v1" itunes:key="L9"><span begin="00:31.680" end="00:31.840">わ</span><span begin="00:31.990" end="00:32.810">か</span><span begin="00:32.810" end="00:33.260">ら</span><span begin="00:33.420" end="00:33.750">な</span><span begin="00:33.750" end="00:33.910">い</span><span begin="00:33.960" end="00:34.210">の</span><span begin="00:34.280" end="00:35.620">で</span><span begin="00:35.620" end="00:35.790">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">也依然不明白</span><span ttm:role="x-translation" xml:lang="zh-Hant">也依然不明白</span><span ttm:role="x-translation" xml:lang="en">I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">알 수가 없어요</span><span ttm:role="x-translation" xml:lang="fr">Je ne comprends toujours pas</span><span ttm:role="x-translation" xml:lang="es">No logro entenderlo</span><span ttm:role="x-translation" xml:lang="de">Verstehe ich es einfach nicht</span><span ttm:role="x-translation" xml:lang="pt">Continuo sem entender</span><span ttm:role="x-translation" xml:lang="ru">Мне всё равно не понять</span><span ttm:role="x-translation" xml:lang="ar">ما زلت لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Non riesco a capire</span><span ttm:role="x-roman">Wakaranai no desu</span></p>
      <p begin="00:36.480" end="00:44.680" ttm:agent="v1" itunes:key="L10"><span begin="00:36.480" end="00:37.260">寂</span><span begin="00:37.340" end="00:37.650">し</span><span begin="00:37.650" end="00:37.900">い</span><span begin="00:38.250" end="00:38.490">な</span><span begin="00:38.490" end="00:38.700">ん</span><span begin="00:38.790" end="00:38.950">て</span><span begin="00:39.040" end="00:39.280">気</span><span begin="00:39.330" end="00:39.510">持</span><span begin="00:39.610" end="00:39.880">ち</span><span begin="00:39.920" end="00:40.240">は</span><span begin="00:40.510" end="00:41.040">知</span><span begin="00:41.040" end="00:41.220">ら</span><span begin="00:41.330" end="00:41.760">な</span><span begin="00:41.870" end="00:42.200">か</span><span begin="00:42.200" end="00:42.730">っ</span><span begin="00:42.730" end="00:43.020">た</span><span begin="00:43.060" end="00:44.680">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">曾经的我还不懂 寂寞是什么滋味</span><span ttm:role="x-translation" xml:lang="zh-Hant">曾經的我還不懂 寂寞是什麼滋味</span><span ttm:role="x-translation" xml:lang="en">I never knew what loneliness felt like</span><span ttm:role="x-translation" xml:lang="ko">외로움이란 감정은 몰랐어</span><span ttm:role="x-translation" xml:lang="fr">Je ne connaissais pas ce sentiment de solitude</span><span ttm:role="x-translation" xml:lang="es">No sabía lo que era sentir soledad</span><span ttm:role="x-translation" xml:lang="de">Ich wusste nicht wie sich Einsamkeit anfühlt</span><span ttm:role="x-translation" xml:lang="pt">Eu não sabia o que era sentir solidão</span><span ttm:role="x-translation" xml:lang="ru">Мне было незнакомо чувство одиночества</span><span ttm:role="x-translation" xml:lang="ar">لم أكن أعرف شعورًا اسمه الوحدة</span><span ttm:role="x-translation" xml:lang="it">Non sapevo cosa fosse la solitudine</span><span ttm:role="x-roman">Sabishii nante kimochi wa shiranakatta yo</span></p>
      <p begin="00:45.570" end="00:53.720" ttm:agent="v1" itunes:key="L11"><span begin="00:45.570" end="00:46.340">嬉</span><span begin="00:46.400" end="00:46.730">し</span><span begin="00:46.730" end="00:46.980">い</span><span begin="00:47.270" end="00:47.530">な</span><span begin="00:47.530" end="00:47.750">ん</span><span begin="00:47.820" end="00:48.020">て</span><span begin="00:48.090" end="00:48.330">気</span><span begin="00:48.400" end="00:48.590">持</span><span begin="00:48.660" end="00:48.910">ち</span><span begin="00:48.960" end="00:49.180">も</span><span begin="00:49.550" end="00:50.110">知</span><span begin="00:50.110" end="00:50.260">り</span><span begin="00:50.380" end="00:50.800">ま</span><span begin="00:50.890" end="00:51.240">せ</span><span begin="00:51.240" end="00:51.780">ん</span><span begin="00:51.780" end="00:52.000">で</span><span begin="00:52.050" end="00:52.270">し</span><span begin="00:52.370" end="00:53.720">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">也不曾懂得 喜悦是什么滋味</span><span ttm:role="x-translation" xml:lang="zh-Hant">也不曾懂得 喜悅是什麼滋味</span><span ttm:role="x-translation" xml:lang="en">And I never knew what happiness felt like either</span><span ttm:role="x-translation" xml:lang="ko">기쁨이란 감정도 몰랐어요</span><span ttm:role="x-translation" xml:lang="fr">Je ne connaissais pas non plus ce sentiment de joie</span><span ttm:role="x-translation" xml:lang="es">Tampoco sabía lo que era sentir alegría</span><span ttm:role="x-translation" xml:lang="de">Und auch nicht wie sich Freude anfühlt</span><span ttm:role="x-translation" xml:lang="pt">Nem sabia o que era sentir alegria</span><span ttm:role="x-translation" xml:lang="ru">И чувство радости мне тоже было незнакомо</span><span ttm:role="x-translation" xml:lang="ar">ولم أكن أعرف شعورًا اسمه الفرح أيضًا</span><span ttm:role="x-translation" xml:lang="it">Non sapevo nemmeno cosa fosse la gioia</span><span ttm:role="x-roman">Ureshii nante kimochi mo shirimasen deshita</span></p>
      <p begin="00:54.870" end="00:59.390" ttm:agent="v1" itunes:key="L12"><span begin="00:54.870" end="00:54.990">な</span><span begin="00:55.040" end="00:55.150">か</span><span begin="00:55.180" end="00:55.270">な</span><span begin="00:55.320" end="00:55.480">か</span><span begin="00:55.480" end="00:55.710">起</span><span begin="00:55.750" end="00:55.920">き</span><span begin="00:55.920" end="00:56.140">れ</span><span begin="00:56.200" end="00:56.310">ず</span><span begin="00:56.380" end="00:56.870">に</span><span begin="00:57.170" end="00:57.310">寝</span><span begin="00:57.330" end="00:57.610">坊</span><span begin="00:57.610" end="00:57.740">で</span><span begin="00:57.740" end="00:58.110">慌</span><span begin="00:58.190" end="00:58.520">て</span><span begin="00:58.590" end="00:58.860">た</span><span begin="00:58.860" end="00:59.390">朝</span><span ttm:role="x-translation" xml:lang="zh-Hans">迟迟起不了床 睡过头后慌慌张张的早晨</span><span ttm:role="x-translation" xml:lang="zh-Hant">遲遲起不了床 睡過頭後慌慌張張的早晨</span><span ttm:role="x-translation" xml:lang="en">A frantic morning after struggling to wake and oversleeping</span><span ttm:role="x-translation" xml:lang="ko">좀처럼 못 일어나 늦잠에 허둥대던 아침</span><span ttm:role="x-translation" xml:lang="fr">Ce matin où je peinais à me lever et m'affolais d'avoir trop dormi</span><span ttm:role="x-translation" xml:lang="es">La mañana en que me costó levantarme y me apuré por dormir de más</span><span ttm:role="x-translation" xml:lang="de">Ein Morgen voller Hast weil ich nicht aus dem Bett kam und verschlief</span><span ttm:role="x-translation" xml:lang="pt">A manhã em que custei a acordar e me afobei por perder a hora</span><span ttm:role="x-translation" xml:lang="ru">Утро когда всё никак не встать а проспав приходится спешить</span><span ttm:role="x-translation" xml:lang="ar">صباح صعب عليّ فيه النهوض فأربكني الاستيقاظ متأخرًا</span><span ttm:role="x-translation" xml:lang="it">La mattina in cui faticavo ad alzarmi e poi correvo perché era tardi</span><span ttm:role="x-roman">Nakanaka okirezu ni nebou de awateta asa</span></p>
      <p begin="00:59.720" end="01:03.650" ttm:agent="v1" itunes:key="L13"><span begin="00:59.720" end="00:59.990">タ</span><span begin="01:00.030" end="01:00.260">オ</span><span begin="01:00.590" end="01:00.810">ル</span><span begin="01:00.860" end="01:01.100">が</span><span begin="01:01.410" end="01:01.960">乾</span><span begin="01:02.270" end="01:02.430">い</span><span begin="01:02.550" end="01:02.780">た</span><span begin="01:03.090" end="01:03.650">昼</span><span ttm:role="x-translation" xml:lang="zh-Hans">毛巾晾干的午间</span><span ttm:role="x-translation" xml:lang="zh-Hant">毛巾晾乾的午間</span><span ttm:role="x-translation" xml:lang="en">An afternoon when the towels dried</span><span ttm:role="x-translation" xml:lang="ko">수건이 마른 한낮</span><span ttm:role="x-translation" xml:lang="fr">Ce midi où les serviettes ont séché</span><span ttm:role="x-translation" xml:lang="es">El mediodía en que se secó la toalla</span><span ttm:role="x-translation" xml:lang="de">Ein Mittag an dem das Handtuch trocken war</span><span ttm:role="x-translation" xml:lang="pt">O meio-dia em que a toalha secou</span><span ttm:role="x-translation" xml:lang="ru">Полдень когда высохло полотенце</span><span ttm:role="x-translation" xml:lang="ar">ظهيرة جفت فيها المنشفة</span><span ttm:role="x-translation" xml:lang="it">A mezzogiorno gli asciugamani ormai asciutti</span><span ttm:role="x-roman">Taoru ga kawaita hiru</span></p>
      <p begin="01:03.950" end="01:08.490" ttm:agent="v1" itunes:key="L14"><span begin="01:03.950" end="01:04.060">あ</span><span begin="01:04.100" end="01:04.180">な</span><span begin="01:04.240" end="01:04.360">た</span><span begin="01:04.400" end="01:04.540">に</span><span begin="01:04.540" end="01:04.570">「</span><span begin="01:04.570" end="01:04.750">お</span><span begin="01:04.810" end="01:04.980">か</span><span begin="01:04.980" end="01:05.240">え</span><span begin="01:05.240" end="01:05.320">り</span><span begin="01:05.320" end="01:05.350">」</span><span begin="01:05.400" end="01:05.850">と</span><span begin="01:06.240" end="01:06.380">言</span><span begin="01:06.380" end="01:06.510">う</span><span begin="01:06.530" end="01:06.640">の</span><span begin="01:06.640" end="01:06.780">を</span><span begin="01:06.810" end="01:06.990">待</span><span begin="01:07.060" end="01:07.230">つ</span><span begin="01:07.230" end="01:07.880">夕</span><span begin="01:07.950" end="01:08.490">方</span><span ttm:role="x-translation" xml:lang="zh-Hans">等着对你说「欢迎回家」的傍晚</span><span ttm:role="x-translation" xml:lang="zh-Hant">等著對你說「歡迎回家」的傍晚</span><span ttm:role="x-translation" xml:lang="en">An evening spent waiting to say "Welcome home" to you</span><span ttm:role="x-translation" xml:lang="ko">네게 “어서 와” 하고 말할 순간을 기다리는 저녁</span><span ttm:role="x-translation" xml:lang="fr">Ce soir où j'attends de te dire « Te voilà de retour »</span><span ttm:role="x-translation" xml:lang="es">La tarde en que espero para decirte «Bienvenido a casa»</span><span ttm:role="x-translation" xml:lang="de">Ein Abend an dem ich darauf warte dir „Willkommen zu Hause“ zu sagen</span><span ttm:role="x-translation" xml:lang="pt">O entardecer à espera de te dizer «Que bom ter você de volta»</span><span ttm:role="x-translation" xml:lang="ru">Вечер когда жду чтобы сказать тебе «С возвращением»</span><span ttm:role="x-translation" xml:lang="ar">مساء أنتظر فيه أن أقول لك «أهلًا بعودتك»</span><span ttm:role="x-translation" xml:lang="it">La sera mentre aspetto di dirti «Bentornato»</span><span ttm:role="x-roman">Anata ni "okaeri" to iu no o matsu yuugata</span></p>
      <p begin="01:08.760" end="01:11.020" ttm:agent="v1" itunes:key="L15"><span begin="01:08.760" end="01:09.290">星</span><span begin="01:09.350" end="01:09.540">の</span><span begin="01:09.640" end="01:09.920">な</span><span begin="01:09.920" end="01:10.230">い</span><span begin="01:10.230" end="01:11.020">夜</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有星星的夜晚</span><span ttm:role="x-translation" xml:lang="zh-Hant">沒有星星的夜晚</span><span ttm:role="x-translation" xml:lang="en">A starless night</span><span ttm:role="x-translation" xml:lang="ko">별 하나 없는 밤</span><span ttm:role="x-translation" xml:lang="fr">Cette nuit sans étoiles</span><span ttm:role="x-translation" xml:lang="es">La noche sin estrellas</span><span ttm:role="x-translation" xml:lang="de">Eine Nacht ohne Sterne</span><span ttm:role="x-translation" xml:lang="pt">A noite sem estrelas</span><span ttm:role="x-translation" xml:lang="ru">Ночь без звёзд</span><span ttm:role="x-translation" xml:lang="ar">ليلة بلا نجوم</span><span ttm:role="x-translation" xml:lang="it">Una notte senza stelle</span><span ttm:role="x-roman">Hoshi no nai yoru</span></p>
      <p begin="01:11.590" end="01:20.230" ttm:agent="v1" itunes:key="L16"><span begin="01:11.590" end="01:11.770">ど</span><span begin="01:11.860" end="01:12.300">こ</span><span begin="01:12.340" end="01:12.660">に</span><span begin="01:12.730" end="01:12.930">も</span><span begin="01:13.000" end="01:14.290">無</span><span begin="01:14.290" end="01:14.420">い</span><span begin="01:14.420" end="01:14.670">ふ</span><span begin="01:14.730" end="01:15.030">つ</span><span begin="01:15.030" end="01:15.790">う</span> <span begin="01:16.390" end="01:16.840">そ</span><span begin="01:16.840" end="01:17.190">れ</span><span begin="01:17.240" end="01:17.450">が</span><span begin="01:17.540" end="01:18.010">素</span><span begin="01:18.110" end="01:18.900">敵</span><span begin="01:18.970" end="01:19.180">な</span><span begin="01:19.240" end="01:19.510">の</span><span begin="01:19.540" end="01:20.230">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">只因这份独一无二的平凡 如此美好</span><span ttm:role="x-translation" xml:lang="zh-Hant">只因這份獨一無二的平凡 如此美好</span><span ttm:role="x-translation" xml:lang="en">Because this ordinary life like no other is so beautiful</span><span ttm:role="x-translation" xml:lang="ko">어디에도 없는 평범함 그게 참 근사해서</span><span ttm:role="x-translation" xml:lang="fr">Parce que cet ordinaire sans pareil est si beau</span><span ttm:role="x-translation" xml:lang="es">Porque lo cotidiano que solo existe aquí es tan hermoso</span><span ttm:role="x-translation" xml:lang="de">Weil dieser Alltag den es sonst nirgendwo gibt so wunderschön ist</span><span ttm:role="x-translation" xml:lang="pt">Porque é tão lindo esse cotidiano que não existe em nenhum outro lugar</span><span ttm:role="x-translation" xml:lang="ru">Ведь так прекрасна эта простая жизнь которой больше нигде не найти</span><span ttm:role="x-translation" xml:lang="ar">لأن هذه الحياة العادية التي لا مثيل لها جميلة</span><span ttm:role="x-translation" xml:lang="it">Perché è così bella questa normalità che non esiste altrove</span><span ttm:role="x-roman">Doko ni mo nai futsuu sore ga suteki na node</span></p>
      <p begin="01:20.680" end="01:30.420" ttm:agent="v1" itunes:key="L17"><span begin="01:20.680" end="01:20.770">い</span><span begin="01:20.800" end="01:20.910">つ</span><span begin="01:20.960" end="01:21.320">ま</span><span begin="01:21.380" end="01:21.760">で</span><span begin="01:21.810" end="01:22.050">も</span><span begin="01:22.090" end="01:23.400">あ</span><span begin="01:23.490" end="01:23.740">な</span><span begin="01:23.780" end="01:24.030">た</span><span begin="01:24.090" end="01:24.840">と</span><span begin="01:25.470" end="01:25.770">ず</span><span begin="01:25.770" end="01:25.910">っ</span><span begin="01:25.910" end="01:26.290">と</span><span begin="01:26.290" end="01:26.610">あ</span><span begin="01:26.610" end="01:27.060">り</span><span begin="01:27.150" end="01:27.460">ふ</span><span begin="01:27.460" end="01:27.910">れ</span><span begin="01:28.020" end="01:28.250">て</span><span begin="01:28.600" end="01:29.260">た</span><span begin="01:29.260" end="01:30.420">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿与你相伴 永远这样平凡下去</span><span ttm:role="x-translation" xml:lang="zh-Hant">願與你相伴 永遠這樣平凡下去</span><span ttm:role="x-translation" xml:lang="en">I want to share this ordinary life with you forever</span><span ttm:role="x-translation" xml:lang="ko">언제까지나 너와 함께 평범하게 살아가고 싶어</span><span ttm:role="x-translation" xml:lang="fr">Je veux vivre avec toi des jours ordinaires pour toujours</span><span ttm:role="x-translation" xml:lang="es">Quiero vivir lo cotidiano contigo para siempre</span><span ttm:role="x-translation" xml:lang="de">Möchte ich für immer mit dir ganz gewöhnlich leben</span><span ttm:role="x-translation" xml:lang="pt">Quero viver dias comuns ao seu lado para sempre</span><span ttm:role="x-translation" xml:lang="ru">Хочу всегда жить с тобой самой обычной жизнью</span><span ttm:role="x-translation" xml:lang="ar">أريد أن أعيش معك حياة عادية إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Vorrei vivere una vita normale con te per sempre</span><span ttm:role="x-roman">Itsumademo anata to zutto arifuretetai</span></p>
      <p begin="01:31.120" end="01:34.900" ttm:agent="v1" itunes:key="L18"><span begin="01:31.120" end="01:31.320">い</span><span begin="01:31.400" end="01:31.650">つ</span><span begin="01:31.710" end="01:31.930">も</span><span begin="01:32.260" end="01:33.050">隣</span><span begin="01:33.370" end="01:33.660">に</span><span begin="01:33.660" end="01:33.960">い</span><span begin="01:33.960" end="01:34.220">る</span><span begin="01:34.270" end="01:34.490">の</span><span begin="01:34.560" end="01:34.900">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明一直都在身旁</span><span ttm:role="x-translation" xml:lang="zh-Hant">明明一直都在身旁</span><span ttm:role="x-translation" xml:lang="en">Though we are always side by side</span><span ttm:role="x-translation" xml:lang="ko">늘 곁에 있는데도</span><span ttm:role="x-translation" xml:lang="fr">Même si tu es toujours à mes côtés</span><span ttm:role="x-translation" xml:lang="es">Aunque siempre estés a mi lado</span><span ttm:role="x-translation" xml:lang="de">Du bist doch immer an meiner Seite</span><span ttm:role="x-translation" xml:lang="pt">Mesmo estando sempre ao seu lado</span><span ttm:role="x-translation" xml:lang="ru">Хоть мы всегда рядом</span><span ttm:role="x-translation" xml:lang="ar">رغم أننا دائمًا جنبًا إلى جنب</span><span ttm:role="x-translation" xml:lang="it">Anche se sei sempre qui accanto a me</span><span ttm:role="x-roman">Itsumo tonari ni iru no ni</span></p>
      <p begin="01:35.640" end="01:39.420" ttm:agent="v1" itunes:key="L19"><span begin="01:35.640" end="01:35.880">で</span><span begin="01:35.970" end="01:36.170">も</span><span begin="01:36.240" end="01:36.450">ね</span> <span begin="01:36.790" end="01:37.020">だ</span><span begin="01:37.080" end="01:37.350">け</span><span begin="01:37.370" end="01:37.650">ど</span> <span begin="01:37.910" end="01:38.130">わ</span><span begin="01:38.210" end="01:38.470">か</span><span begin="01:38.500" end="01:38.680">ら</span><span begin="01:38.780" end="01:39.090">な</span><span begin="01:39.090" end="01:39.420">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">可是啊 可是 我还是不懂</span><span ttm:role="x-translation" xml:lang="zh-Hant">可是啊 可是 我還是不懂</span><span ttm:role="x-translation" xml:lang="en">But even so I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">그런데 말이야 그래도 모르겠어</span><span ttm:role="x-translation" xml:lang="fr">Mais tu sais je ne comprends pas</span><span ttm:role="x-translation" xml:lang="es">Pero aun así no lo entiendo</span><span ttm:role="x-translation" xml:lang="de">Aber weißt du ich verstehe es nicht</span><span ttm:role="x-translation" xml:lang="pt">Mas sabe ainda assim não entendo</span><span ttm:role="x-translation" xml:lang="ru">Но знаешь всё же я не понимаю</span><span ttm:role="x-translation" xml:lang="ar">لكنني مع ذلك لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Eppure sai non capisco</span><span ttm:role="x-roman">Demo ne dakedo wakaranai</span></p>
      <p begin="01:40.170" end="01:43.850" ttm:agent="v1" itunes:key="L20"><span begin="01:40.170" end="01:40.390">い</span><span begin="01:40.450" end="01:40.750">く</span><span begin="01:40.750" end="01:41.000">ら</span><span begin="01:41.310" end="01:41.860">数</span><span begin="01:41.900" end="01:42.120">を</span><span begin="01:42.440" end="01:43.080">数</span><span begin="01:43.080" end="01:43.220">え</span><span begin="01:43.310" end="01:43.530">て</span><span begin="01:43.640" end="01:43.850">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论数过多少个数</span><span ttm:role="x-translation" xml:lang="zh-Hant">無論數過多少個數</span><span ttm:role="x-translation" xml:lang="en">No matter how many numbers I count</span><span ttm:role="x-translation" xml:lang="ko">아무리 수를 세어 봐도</span><span ttm:role="x-translation" xml:lang="fr">J'ai beau compter et recompter</span><span ttm:role="x-translation" xml:lang="es">Por más números que cuente</span><span ttm:role="x-translation" xml:lang="de">Wie viele Zahlen ich auch zähle</span><span ttm:role="x-translation" xml:lang="pt">Por mais que eu conte os números</span><span ttm:role="x-translation" xml:lang="ru">Сколько ни считаю</span><span ttm:role="x-translation" xml:lang="ar">مهما واصلت عد الأرقام</span><span ttm:role="x-translation" xml:lang="it">Per quanto conti e riconti</span><span ttm:role="x-roman">Ikura kazu o kazoete mo</span></p>
      <p begin="01:44.160" end="01:49.040" ttm:agent="v1" itunes:key="L21"><span begin="01:44.160" end="01:44.320">わ</span><span begin="01:44.430" end="01:45.230">か</span><span begin="01:45.280" end="01:45.780">ら</span><span begin="01:45.870" end="01:46.260">な</span><span begin="01:46.260" end="01:46.390">い</span><span begin="01:46.420" end="01:46.660">の</span><span begin="01:46.740" end="01:48.840">で</span><span begin="01:48.840" end="01:49.040">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">也依然不明白</span><span ttm:role="x-translation" xml:lang="zh-Hant">也依然不明白</span><span ttm:role="x-translation" xml:lang="en">I still do not understand</span><span ttm:role="x-translation" xml:lang="ko">알 수가 없어요</span><span ttm:role="x-translation" xml:lang="fr">Je ne comprends toujours pas</span><span ttm:role="x-translation" xml:lang="es">No logro entenderlo</span><span ttm:role="x-translation" xml:lang="de">Verstehe ich es einfach nicht</span><span ttm:role="x-translation" xml:lang="pt">Continuo sem entender</span><span ttm:role="x-translation" xml:lang="ru">Мне всё равно не понять</span><span ttm:role="x-translation" xml:lang="ar">ما زلت لا أفهم</span><span ttm:role="x-translation" xml:lang="it">Non riesco a capire</span><span ttm:role="x-roman">Wakaranai no desu</span></p>
      <p begin="01:49.530" end="01:52.820" ttm:agent="v1" itunes:key="L22"><span begin="01:49.530" end="01:49.860">Run</span> <span begin="01:49.860" end="01:50.230">of</span> <span begin="01:50.230" end="01:50.340">the</span> <span begin="01:50.420" end="01:50.690">mi</span><span begin="01:50.690" end="01:50.960">ll</span> <span begin="01:52.070" end="01:52.310">ah</span> <span begin="01:52.390" end="01:52.820">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d'extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p>
      <p begin="01:54.070" end="01:55.650" ttm:agent="v1" itunes:key="L23"><span begin="01:54.070" end="01:54.400">But</span> <span begin="01:54.400" end="01:54.660">I</span> <span begin="01:54.660" end="01:54.910">love</span> <span begin="01:54.910" end="01:55.230">those</span> <span begin="01:55.230" end="01:55.520">thing</span><span begin="01:55.520" end="01:55.650">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j'aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p>
      <p begin="01:56.570" end="01:58.300" ttm:agent="v1" itunes:key="L24"><span begin="01:56.570" end="01:57.040">For</span><span begin="01:57.450" end="01:58.020">e</span><span begin="01:58.020" end="01:58.300">ver</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到永远</span><span ttm:role="x-translation" xml:lang="zh-Hant">直到永遠</span><span ttm:role="x-translation" xml:lang="ja">いつまでも</span><span ttm:role="x-translation" xml:lang="ko">영원히</span><span ttm:role="x-translation" xml:lang="fr">Pour toujours</span><span ttm:role="x-translation" xml:lang="es">Para siempre</span><span ttm:role="x-translation" xml:lang="de">Für immer</span><span ttm:role="x-translation" xml:lang="pt">Para sempre</span><span ttm:role="x-translation" xml:lang="ru">Навсегда</span><span ttm:role="x-translation" xml:lang="ar">إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Per sempre</span></p>
      <p begin="01:58.610" end="02:01.890" ttm:agent="v1" itunes:key="L25"><span begin="01:58.610" end="01:58.920">Run</span> <span begin="01:58.920" end="01:59.280">of</span> <span begin="01:59.280" end="01:59.400">the</span> <span begin="01:59.470" end="01:59.760">mi</span><span begin="01:59.760" end="01:59.990">ll</span> <span begin="02:01.110" end="02:01.400">ah</span> <span begin="02:01.470" end="02:01.890">ah</span><span ttm:role="x-translation" xml:lang="zh-Hans">平凡无奇 啊 啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">平凡無奇 啊 啊</span><span ttm:role="x-translation" xml:lang="ja">ありふれた日々 ああ ああ</span><span ttm:role="x-translation" xml:lang="ko">그저 평범해 아 아</span><span ttm:role="x-translation" xml:lang="fr">Rien d'extraordinaire ah ah</span><span ttm:role="x-translation" xml:lang="es">Cosas de cada día ah ah</span><span ttm:role="x-translation" xml:lang="de">Ganz gewöhnlich ah ah</span><span ttm:role="x-translation" xml:lang="pt">Coisas tão comuns ah ah</span><span ttm:role="x-translation" xml:lang="ru">Всё так обычно а а</span><span ttm:role="x-translation" xml:lang="ar">أشياء عادية آه آه</span><span ttm:role="x-translation" xml:lang="it">Cose di tutti i giorni ah ah</span></p>
      <p begin="02:03.120" end="02:04.660" ttm:agent="v1" itunes:key="L26"><span begin="02:03.120" end="02:03.440">But</span> <span begin="02:03.440" end="02:03.710">I</span> <span begin="02:03.710" end="02:03.960">love</span> <span begin="02:03.960" end="02:04.230">those</span> <span begin="02:04.230" end="02:04.580">thing</span><span begin="02:04.580" end="02:04.660">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我深爱着这一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">可我深愛著這一切</span><span ttm:role="x-translation" xml:lang="ja">でも そんな日々が愛おしい</span><span ttm:role="x-translation" xml:lang="ko">그래도 난 그런 것들을 사랑해</span><span ttm:role="x-translation" xml:lang="fr">Mais j'aime tout cela</span><span ttm:role="x-translation" xml:lang="es">Pero amo esas cosas</span><span ttm:role="x-translation" xml:lang="de">Doch ich liebe all das</span><span ttm:role="x-translation" xml:lang="pt">Mas eu amo tudo isso</span><span ttm:role="x-translation" xml:lang="ru">Но я так люблю всё это</span><span ttm:role="x-translation" xml:lang="ar">لكنني أحب تلك الأشياء</span><span ttm:role="x-translation" xml:lang="it">Ma io amo queste cose</span></p>
      <p begin="02:05.080" end="02:14.630" ttm:agent="v1" itunes:key="L27"><span begin="02:05.080" end="02:05.270">あ</span><span begin="02:05.320" end="02:05.510">た</span><span begin="02:05.510" end="02:05.640">り</span><span begin="02:05.690" end="02:05.930">ま</span><span begin="02:05.930" end="02:06.070">え</span><span begin="02:06.090" end="02:06.180">に</span><span begin="02:06.220" end="02:06.570">続</span><span begin="02:06.630" end="02:06.730">き</span><span begin="02:06.780" end="02:07.210">そう</span><span begin="02:07.210" end="02:07.320">な</span><span begin="02:07.370" end="02:08.790">毎</span><span begin="02:08.790" end="02:09.320">日</span><span begin="02:09.380" end="02:10.240">が</span><span begin="02:10.760" end="02:11.080">と</span><span begin="02:11.180" end="02:11.560">て</span><span begin="02:11.600" end="02:11.790">も</span><span begin="02:11.890" end="02:12.360">素</span><span begin="02:12.440" end="02:13.260">敵</span><span begin="02:13.300" end="02:13.520">な</span><span begin="02:13.580" end="02:13.870">の</span><span begin="02:13.910" end="02:14.630">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">只因这些仿佛会自然而然延续的日子 如此美好</span><span ttm:role="x-translation" xml:lang="zh-Hant">只因這些彷彿會自然而然延續的日子 如此美好</span><span ttm:role="x-translation" xml:lang="en">Because these days that seem to carry on so naturally are so beautiful</span><span ttm:role="x-translation" xml:lang="ko">당연한 듯 이어질 것 같은 하루하루가 너무나 근사해서</span><span ttm:role="x-translation" xml:lang="fr">Parce que ce quotidien qui semble se poursuivre tout naturellement est si beau</span><span ttm:role="x-translation" xml:lang="es">Porque este día a día que parece seguir sin más es tan hermoso</span><span ttm:role="x-translation" xml:lang="de">Weil dieser Alltag der wie selbstverständlich weiterzugehen scheint so wunderschön ist</span><span ttm:role="x-translation" xml:lang="pt">Porque é tão lindo esse dia a dia que parece seguir tão naturalmente</span><span ttm:role="x-translation" xml:lang="ru">Ведь так прекрасны эти дни что будто и дальше будут идти своим чередом</span><span ttm:role="x-translation" xml:lang="ar">لأن هذه الأيام التي تبدو كأنها ستتوالى كالمعتاد جميلة جدًا</span><span ttm:role="x-translation" xml:lang="it">Perché sono così belli questi giorni che sembrano continuare come sempre</span><span ttm:role="x-roman">Atarimae ni tsuzukisou na mainichi ga totemo suteki na node</span></p>
      <p begin="02:15.000" end="02:24.850" ttm:agent="v1" itunes:key="L28"><span begin="02:15.000" end="02:15.100">い</span><span begin="02:15.140" end="02:15.250">つ</span><span begin="02:15.290" end="02:15.670">ま</span><span begin="02:15.700" end="02:16.080">で</span><span begin="02:16.130" end="02:16.420">も</span><span begin="02:16.420" end="02:17.770">あ</span><span begin="02:17.830" end="02:18.060">な</span><span begin="02:18.100" end="02:18.350">た</span><span begin="02:18.400" end="02:19.200">と</span><span begin="02:19.790" end="02:20.090">ず</span><span begin="02:20.090" end="02:20.250">っ</span><span begin="02:20.250" end="02:20.630">と</span><span begin="02:20.630" end="02:20.920">あ</span><span begin="02:20.920" end="02:21.370">り</span><span begin="02:21.490" end="02:21.780">ふ</span><span begin="02:21.780" end="02:22.240">れ</span><span begin="02:22.360" end="02:22.620">て</span><span begin="02:22.930" end="02:23.600">た</span><span begin="02:23.600" end="02:24.850">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿与你相伴 永远这样平凡下去</span><span ttm:role="x-translation" xml:lang="zh-Hant">願與你相伴 永遠這樣平凡下去</span><span ttm:role="x-translation" xml:lang="en">I want to share this ordinary life with you forever</span><span ttm:role="x-translation" xml:lang="ko">언제까지나 너와 함께 평범하게 살아가고 싶어</span><span ttm:role="x-translation" xml:lang="fr">Je veux vivre avec toi des jours ordinaires pour toujours</span><span ttm:role="x-translation" xml:lang="es">Quiero vivir lo cotidiano contigo para siempre</span><span ttm:role="x-translation" xml:lang="de">Möchte ich für immer mit dir ganz gewöhnlich leben</span><span ttm:role="x-translation" xml:lang="pt">Quero viver dias comuns ao seu lado para sempre</span><span ttm:role="x-translation" xml:lang="ru">Хочу всегда жить с тобой самой обычной жизнью</span><span ttm:role="x-translation" xml:lang="ar">أريد أن أعيش معك حياة عادية إلى الأبد</span><span ttm:role="x-translation" xml:lang="it">Vorrei vivere una vita normale con te per sempre</span><span ttm:role="x-roman">Itsumademo anata to zutto arifuretetai</span></p>
      <p begin="02:25.460" end="02:29.080" ttm:agent="v1" itunes:key="L29"><span begin="02:25.460" end="02:25.770">晴</span><span begin="02:25.770" end="02:25.990">れ</span><span begin="02:26.030" end="02:26.250">の</span><span begin="02:26.310" end="02:26.580">日</span><span begin="02:26.630" end="02:26.840">も</span><span begin="02:27.170" end="02:27.700">雨</span><span begin="02:27.750" end="02:28.040">降</span><span begin="02:28.040" end="02:28.250">り</span><span begin="02:28.290" end="02:28.530">の</span><span begin="02:28.570" end="02:28.850">日</span><span begin="02:28.900" end="02:29.080">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论晴朗的日子 还是下雨的日子</span><span ttm:role="x-translation" xml:lang="zh-Hant">無論晴朗的日子 還是下雨的日子</span><span ttm:role="x-translation" xml:lang="en">On sunny days and on rainy days</span><span ttm:role="x-translation" xml:lang="ko">맑은 날도 비 내리는 날도</span><span ttm:role="x-translation" xml:lang="fr">Les jours de soleil comme les jours de pluie</span><span ttm:role="x-translation" xml:lang="es">Los días de sol y los días de lluvia</span><span ttm:role="x-translation" xml:lang="de">An sonnigen Tagen und an Regentagen</span><span ttm:role="x-translation" xml:lang="pt">Nos dias de sol e nos dias de chuva</span><span ttm:role="x-translation" xml:lang="ru">И в солнечные дни и в дождливые</span><span ttm:role="x-translation" xml:lang="ar">في الأيام المشمسة وفي الأيام الماطرة</span><span ttm:role="x-translation" xml:lang="it">Nei giorni di sole e in quelli di pioggia</span><span ttm:role="x-roman">Hare no hi mo amefuri no hi mo</span></p>
      <p begin="02:29.420" end="02:33.800" ttm:agent="v1" itunes:key="L30"><span begin="02:29.420" end="02:30.010">笑</span><span begin="02:30.010" end="02:30.310">い</span><span begin="02:30.310" end="02:30.560">合</span><span begin="02:30.560" end="02:30.800">う</span><span begin="02:30.850" end="02:31.150">日</span><span begin="02:31.150" end="02:31.340">も</span><span begin="02:31.720" end="02:32.210">憂</span><span begin="02:32.260" end="02:32.790">鬱</span><span begin="02:32.840" end="02:33.040">な</span><span begin="02:33.100" end="02:33.360">日</span><span begin="02:33.450" end="02:33.800">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论一同欢笑的日子 还是心情低落的日子</span><span ttm:role="x-translation" xml:lang="zh-Hant">無論一同歡笑的日子 還是心情低落的日子</span><span ttm:role="x-translation" xml:lang="en">On days we laugh together and days we feel blue</span><span ttm:role="x-translation" xml:lang="ko">함께 웃는 날도 울적한 날도</span><span ttm:role="x-translation" xml:lang="fr">Les jours où l'on rit ensemble comme les jours de mélancolie</span><span ttm:role="x-translation" xml:lang="es">Los días de risas compartidas y los días de tristeza</span><span ttm:role="x-translation" xml:lang="de">An Tagen an denen wir zusammen lachen und an trüben Tagen</span><span ttm:role="x-translation" xml:lang="pt">Nos dias em que rimos juntos e nos dias de melancolia</span><span ttm:role="x-translation" xml:lang="ru">И в дни когда смеёмся вместе и в дни печали</span><span ttm:role="x-translation" xml:lang="ar">في الأيام التي نضحك فيها معًا وفي الأيام الكئيبة</span><span ttm:role="x-translation" xml:lang="it">Nei giorni in cui ridiamo insieme e in quelli malinconici</span><span ttm:role="x-roman">Waraiau hi mo yuuutsu na hi mo</span></p>
      <p begin="02:34.510" end="02:38.130" ttm:agent="v1" itunes:key="L31"><span begin="02:34.510" end="02:34.740">ど</span><span begin="02:34.810" end="02:35.060">こ</span><span begin="02:35.130" end="02:35.310">に</span><span begin="02:35.370" end="02:35.630">で</span><span begin="02:35.680" end="02:35.880">も</span><span begin="02:36.230" end="02:36.510">あ</span><span begin="02:36.510" end="02:36.660">り</span><span begin="02:36.760" end="02:37.100">そ</span><span begin="02:37.100" end="02:37.330">う</span><span begin="02:37.360" end="02:37.560">な</span><span begin="02:37.630" end="02:37.900">日</span><span begin="02:37.960" end="02:38.130">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">还有那些仿佛随处可见的日子</span><span ttm:role="x-translation" xml:lang="zh-Hant">還有那些彷彿隨處可見的日子</span><span ttm:role="x-translation" xml:lang="en">Even on days that seem just like any other</span><span ttm:role="x-translation" xml:lang="ko">어디에나 있을 법한 날도</span><span ttm:role="x-translation" xml:lang="fr">Même ces jours comme on en vit partout</span><span ttm:role="x-translation" xml:lang="es">También los días como tantos otros</span><span ttm:role="x-translation" xml:lang="de">Auch an Tagen wie es sie überall gibt</span><span ttm:role="x-translation" xml:lang="pt">Mesmo nos dias que parecem tão comuns</span><span ttm:role="x-translation" xml:lang="ru">И в дни что кажутся самыми обычными</span><span ttm:role="x-translation" xml:lang="ar">وفي الأيام التي قد تجد مثلها في كل مكان</span><span ttm:role="x-translation" xml:lang="it">Anche nei giorni che sembrano uguali a tanti altri</span><span ttm:role="x-roman">Doko ni demo arisou na hi mo</span></p>
      <p begin="02:38.500" end="02:43.450" ttm:agent="v1" itunes:key="L32"><span begin="02:38.500" end="02:38.760">た</span><span begin="02:38.800" end="02:39.080">だ</span><span begin="02:39.080" end="02:39.280">い</span><span begin="02:39.340" end="02:39.580">つ</span><span begin="02:39.650" end="02:39.880">ま</span><span begin="02:39.910" end="02:40.160">で</span><span begin="02:40.210" end="02:40.420">も</span> <span begin="02:40.750" end="02:41.000">た</span><span begin="02:41.060" end="02:41.320">だ</span><span begin="02:41.320" end="02:41.540">い</span><span begin="02:41.620" end="02:41.870">つ</span><span begin="02:41.930" end="02:42.140">ま</span><span begin="02:42.200" end="02:42.450">で</span><span begin="02:42.530" end="02:43.450">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">只愿永远如此 只愿永远如此</span><span ttm:role="x-translation" xml:lang="zh-Hant">只願永遠如此 只願永遠如此</span><span ttm:role="x-translation" xml:lang="en">Just forever  just forever</span><span ttm:role="x-translation" xml:lang="ko">그저 언제까지나 그저 언제까지나</span><span ttm:role="x-translation" xml:lang="fr">Simplement pour toujours simplement pour toujours</span><span ttm:role="x-translation" xml:lang="es">Tan solo para siempre tan solo para siempre</span><span ttm:role="x-translation" xml:lang="de">Einfach für immer einfach für immer</span><span ttm:role="x-translation" xml:lang="pt">Só para sempre só para sempre</span><span ttm:role="x-translation" xml:lang="ru">Просто навсегда просто навсегда</span><span ttm:role="x-translation" xml:lang="ar">إلى الأبد فحسب إلى الأبد فحسب</span><span ttm:role="x-translation" xml:lang="it">Soltanto per sempre soltanto per sempre</span><span ttm:role="x-roman">Tada itsumademo tada itsumademo</span></p>
    </div>
  </body>
</tt>
